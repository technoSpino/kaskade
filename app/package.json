{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:kaskade": "playwright test -c playwright.kaskade.config.js",
    "screenshots:kaskade": "KASKADE_SCREENSHOTS=1 playwright test -c playwright.kaskade.config.js screenshots",
    "screenshots:kaskade:filled": "KASKADE_SCREENSHOTS=filled playwright test -c playwright.kaskade.config.js screenshots"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@tailwindcss/postcss": "^4.1.17",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.22",
    "pinia": "^3.0.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.4",
    "vitest": "^3.2.7"
  }
}
